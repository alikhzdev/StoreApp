<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginStart="4dp"
    android:layout_width="160dp"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/Image_item_favorit2"
        android:layout_width="150dp"
        android:layout_height="210dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/background_cardview1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="ContentDescription,MissingConstraints" />

    <TextView
        android:id="@+id/text1_item_favorit2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="80dp"
        android:text="وظایف کامل شده\n من نمی دانم"
        android:textColor="@color/color_white"
        android:textSize="15dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/Image_item_favorit2"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@id/Image_item_favorit2"
        app:layout_constraintTop_toTopOf="@id/Image_item_favorit2"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/text2_item_favorit2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="6استکر"
        android:textColor="#4D6460"
        app:layout_constraintEnd_toEndOf="@id/Image_item_favorit2"
        app:layout_constraintHorizontal_bias="0.946"
        app:layout_constraintStart_toStartOf="@id/Image_item_favorit2"
        app:layout_constraintTop_toBottomOf="@id/text1_item_favorit2"
        tools:ignore="MissingConstraints" />


    <androidx.cardview.widget.CardView
        android:layout_width="45dp"
        android:layout_height="32dp"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="20dp"
        android:background="#D6E5FB"
        app:cardCornerRadius="30dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text2_item_favorit2"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/Text_in_favorit2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:layout_gravity="center"
            android:padding="5dp"
            android:text="رایگان"
            android:textColor="#5C42DC"
            android:textSize="13sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>




</androidx.constraintlayout.widget.ConstraintLayout>