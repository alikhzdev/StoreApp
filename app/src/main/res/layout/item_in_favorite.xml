<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginStart="5dp"
    android:layout_width="380dp"
    android:layout_height="wrap_content">


    <ImageView
        android:layout_marginBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/Image_item_favorite"
        android:src="@drawable/background_cardview1"
        android:layout_width="370dp"
        android:layout_height="210dp"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="ContentDescription,MissingConstraints" />


    <TextView
        android:id="@+id/text1_item_favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="10sp"
        android:text="وظایف کامل شده\n من نمی دانم"
        android:textColor="@color/color_white"
        android:textSize="15dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/Image_item_favorite"
        app:layout_constraintHorizontal_bias="0.935"
        app:layout_constraintStart_toStartOf="@id/Image_item_favorite"
        app:layout_constraintTop_toTopOf="@id/Image_item_favorite"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/text2_item_favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:text="6استکر"
        android:textColor="#4D6460"
        app:layout_constraintBottom_toBottomOf="@id/Image_item_favorite"
        app:layout_constraintEnd_toEndOf="@id/Image_item_favorite"
        app:layout_constraintHorizontal_bias="0.894"
        app:layout_constraintStart_toStartOf="@id/Image_item_favorite"
        app:layout_constraintTop_toBottomOf="@id/text1_item_favorite"
        app:layout_constraintVertical_bias="0.542"
        tools:ignore="MissingConstraints" />


</androidx.constraintlayout.widget.ConstraintLayout>