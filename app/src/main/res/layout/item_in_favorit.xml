<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="320dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp">

    <!-- کارت‌های پشت‌زمینه -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card1_item_favorit"
        android:layout_width="180dp"
        android:layout_height="250dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="40dp"
        android:translationX="-30dp"
        android:translationY="-20dp"
        android:backgroundTint="#FF5722">

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card2_item_favorit"
        android:layout_width="180dp"
        android:layout_height="250dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="40dp"
        android:translationY="8dp"
        android:translationX="-10dp"
        android:backgroundTint="#4CAF50">

    </androidx.cardview.widget.CardView>

    <!-- کارت اصلی -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card3_item_favorit"
        android:layout_width="180dp"
        android:layout_height="250dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="40dp"
        android:backgroundTint="#3F51B5"
        android:translationY="30dp"
        android:translationX="10dp"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- برچسب ویژه -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ویژه"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:padding="6dp"
                android:background="@drawable/label_background"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="30dp"/>

            <!-- متن داخل کارت -->
            <TextView
                android:id="@+id/text1_item_favorit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="وظایف کامل شده\nرا نمی‌دانم"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="100dp"
                />

            <!-- متن کوچک زیرین -->
            <TextView
                android:id="@+id/text2_item_favorit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۶ امتیاز"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#B0C4DE"
                android:layout_marginTop="170dp"
                android:layout_marginStart="110dp"/>

            <FrameLayout
                android:id="@+id/Fraglayoutfavorite3"
                android:layout_width="35dp"
                android:layout_height="25dp"
                android:layout_marginStart="100dp"
                android:layout_marginTop="207dp"
                android:layout_marginBottom="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                >

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_border_orange3"
                    android:padding="8dp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_boy_foritem"
                    android:padding="8dp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plas_foritem" />
            </FrameLayout>


            <Button
                android:id="@+id/button_item_favorit3"
                android:layout_width="80dp"
                android:layout_height="25dp"
                android:layout_gravity="bottom"
                android:layout_marginTop="207dp"
                android:layout_marginStart="15dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/button_favorit3_background"
                android:text=" 25000ت"
                android:textColor="@color/color_white"
                android:textStyle="bold"

                app:layout_constraintEnd_toStartOf="@id/Fraglayoutfavorite3"
                />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>





</FrameLayout>
