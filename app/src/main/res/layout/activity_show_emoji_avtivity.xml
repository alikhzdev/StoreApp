<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F5FF"
    tools:context=".ui.ShowEmojiActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="351dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="0dp"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toTopOf="@+id/cardView3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription,MissingConstraints" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cartView"
        android:layout_width="370dp"
        android:layout_height="210dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="1dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView"
        tools:ignore="MissingConstraints">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <TextView
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="55dp"
                android:layout_marginTop="75dp"
                android:fontFamily="@font/font3"
                android:text="وظایف کامل شده\n من نمی دانم"
                android:textColor="@color/color_black"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="115dp"
                android:layout_marginTop="140dp"
                android:fontFamily="@font/font3"
                android:text="6استکر"
                android:textColor="#4D6460"
                android:textSize="19sp"

                tools:ignore="MissingConstraints" />

        </RelativeLayout>


    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView3"
        android:layout_width="150dp"
        android:layout_height="210dp"
        android:layout_marginStart="160dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="21dp"
        app:layout_constraintBottom_toBottomOf="@+id/cartView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView"
        tools:ignore="MissingConstraints">


        <RelativeLayout
            android:id="@+id/Relative_item_favoritee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/background_cardview4">


            <ImageView
                android:id="@+id/imageSanta"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="26dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_emoji"
                android:translationY="60dp"
                tools:ignore="ObsoleteLayoutParam" />
        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/linear_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:elevation="21dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cartView"
        tools:ignore="UselessLeaf">


        <Button
            android:id="@+id/btntakhfif"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:background="@drawable/background_btn"
            android:text="رایگان"
            android:textColor="@color/color_black"
            android:textSize="23sp"
            android:textStyle="bold"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="-30dp"
            tools:layout_editor_absoluteY="307dp" />

        <Button
            android:id="@+id/btnpol"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/button_favorit3_background"
            android:text="رایگان"
            android:textColor="@color/color_white"
            android:textSize="23sp"
            android:textStyle="bold"
            android:elevation="22dp"
            tools:ignore="HardcodedText,MissingConstraints"
            tools:layout_editor_absoluteX="-30dp"
            tools:layout_editor_absoluteY="307dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linear_button2"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:elevation="21dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cartView">


        <Button
            android:id="@+id/btnpol2"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/button_favorit3_background"
            android:text="رایگان"
            android:textColor="@color/color_white"
            android:textSize="23sp"
            android:textStyle="bold"
            android:elevation="22dp"
            tools:ignore="MissingConstraints" />


    </LinearLayout>

    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_card_background"
        android:text="افزودن به سبد خرید"
        android:textColor="@color/color_white"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/text3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linear_button"
        tools:ignore="MissingConstraints" />


    <TextView
        android:id="@+id/text3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="265dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/font3"
        android:text="پک استیکر"
        android:textColor="@color/color_black"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button"
        tools:ignore="MissingConstraints" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewEmoji"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_marginTop="5dp"
        android:orientation="vertical"
        android:paddingStart="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintTop_toBottomOf="@id/text3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="MissingConstraints" />


</androidx.constraintlayout.widget.ConstraintLayout>