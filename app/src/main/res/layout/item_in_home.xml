<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginStart="7dp"
    android:layout_marginBottom="10dp"
    android:layout_width="160dp"
    android:layout_marginTop="0dp"
    android:layout_height="200dp">


    <androidx.cardview.widget.CardView
        android:id="@+id/card_item_home"
        android:layout_width="130dp"
        android:layout_height="180dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="0dp"
        app:cardCornerRadius="24dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="4dp">




        <RelativeLayout
            android:id="@+id/Relative_item_home"
            android:background="@drawable/background_cardview4"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- متن داخل کارت -->
            <TextView
                android:id="@+id/text1_item_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="وظایف کامل شده\nرا نمی‌دانم"
                android:textSize="12sp"
                android:fontFamily="@font/font3"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="80dp"
                />

            <!-- متن کوچک زیرین -->
            <TextView
                android:id="@+id/text2_item_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۶ امتیاز"
                android:fontFamily="@font/font3"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#B0C4DE"
                android:layout_marginTop="119dp"
                android:layout_marginStart="80dp"/>




        </RelativeLayout>

    </androidx.cardview.widget.CardView>


    <ImageView
        android:id="@+id/imageSanta"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_emoji"
        android:scaleType="centerInside"
        android:layout_marginStart="26dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:translationY="-0dp"
        tools:ignore="ObsoleteLayoutParam" />


</FrameLayout>