<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginStart="7dp"
    android:layout_marginBottom="10dp"
    android:layout_width="140dp"
    android:layoutDirection="ltr"
    android:layout_marginTop="0dp"
    android:layout_height="200dp">


    <androidx.cardview.widget.CardView
        android:id="@+id/card_item_home"
        android:layout_width="130dp"
        android:layout_height="180dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="0dp"
        app:cardCornerRadius="24dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="4dp">




        <RelativeLayout
            android:id="@+id/Relative_item_favorite3"
            android:background="@drawable/background_cardview4"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- متن داخل کارت -->
            <TextView
                android:id="@+id/text1_item_favorit3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="وظایف کامل شده\nرا نمی‌دانم"
                android:textSize="12sp"
                android:fontFamily="@font/font3"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="80dp"
                />

            <!-- متن کوچک زیرین -->
            <TextView
                android:id="@+id/text2_item_favorit3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۶ امتیاز"
                android:fontFamily="@font/font3"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#B0C4DE"
                android:layout_marginTop="100dp"
                android:layout_marginStart="80dp"/>


            <FrameLayout
                android:id="@+id/Fraglayoutfavorite3"
                android:layout_width="35dp"
                android:layout_height="29dp"
                android:layout_marginStart="85dp"
                android:layout_marginTop="145dp"
                android:layout_marginBottom="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                >

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_border_orange3"
                    android:padding="8dp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_boy_foritem"
                    android:padding="8dp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plas_foritem" />
            </FrameLayout>


            <Button
                android:id="@+id/button_item_favorit3"
                android:layout_width="75dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom"
                android:layout_marginTop="144dp"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/button_favorit3_background"
                android:text=" 25000ت"
                android:textSize="14sp"
                android:fontFamily="@font/font3"
                android:textColor="@color/color_white"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/Fraglayoutfavorite3"
                tools:ignore="HardcodedText" />




        </RelativeLayout>

    </androidx.cardview.widget.CardView>


    <ImageView
        android:id="@+id/imagePack"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_emoji"
        android:scaleType="centerInside"
        android:layout_marginStart="26dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:translationY="-0dp"
        tools:ignore="ObsoleteLayoutParam" />


</FrameLayout>







