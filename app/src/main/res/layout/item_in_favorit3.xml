<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginStart="4dp"
    android:layout_width="160dp"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/Image_item_favorit3"
        android:layout_width="150dp"
        android:layout_height="210dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/background_cardview1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="ContentDescription,MissingConstraints" />

    <TextView
        android:id="@+id/text1_item_favorit3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="80dp"
        android:text="وظایف کامل شده\n من نمی دانم"
        android:textColor="@color/color_white"
        android:textSize="15dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/Image_item_favorit3"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@id/Image_item_favorit3"
        app:layout_constraintTop_toTopOf="@id/Image_item_favorit3"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/text2_item_favorit3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="6استکر"
        android:textColor="#4D6460"
        app:layout_constraintBottom_toBottomOf="@id/Image_item_favorit3"
        app:layout_constraintEnd_toEndOf="@id/Image_item_favorit3"
        app:layout_constraintHorizontal_bias="0.946"
        app:layout_constraintStart_toStartOf="@id/Image_item_favorit3"
        app:layout_constraintTop_toBottomOf="@id/text1_item_favorit3"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="MissingConstraints" />

    <FrameLayout
        android:id="@+id/Fraglayoutfavorite3"
        android:layout_width="35dp"
        android:layout_height="25dp"
        android:layout_marginStart="60dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="@id/Image_item_favorit3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text2_item_favorit3"
        tools:ignore="MissingConstraints">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/circle_border_orange3"
            android:padding="8dp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/ic_boy_foritem"
            android:padding="8dp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:src="@drawable/ic_plas_foritem" />
    </FrameLayout>


    <Button
        android:id="@+id/button_item_favorit3"
        android:layout_width="80dp"
        android:layout_height="25dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="20dp"
        android:background="@drawable/button_favorit3_background"
        android:text=" 25000ت"
        android:textSize="12sp"
        android:textColor="@color/color_white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/Image_item_favorit3"
        app:layout_constraintEnd_toStartOf="@id/Fraglayoutfavorite3"
        app:layout_constraintStart_toStartOf="@id/Image_item_favorit3"
        tools:ignore="MissingConstraints" />





</androidx.constraintlayout.widget.ConstraintLayout>