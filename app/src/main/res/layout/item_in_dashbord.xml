<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:id="@+id/Linear_for_item_Dashbord"
        android:layout_width="150dp"
        android:layout_height="210dp"
        android:gravity="end"
        android:orientation="vertical"
        android:background="@drawable/background_cardview1"
        tools:ignore="MissingConstraints">


        <TextView
            android:id="@+id/text1_item_dashbord"
            android:layout_marginHorizontal="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:layout_marginEnd="10sp"
            android:text="وظایف کامل شده\n من نمی دانم"
            android:textColor="@color/color_white"
            android:textSize="15dp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/text2_item_dashbord"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="5dp"
            android:text="6استکر"
            android:textColor="#4D6460"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>



    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>